{
  "name": "@fishsense/web",
  "version": "0.63.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.config.integration.ts",
    "api:generate": "openapi-typescript openapi.json --output lib/api/schema.d.ts",
    "api:check": "openapi-typescript openapi.json --output lib/api/schema.d.ts --check",
    "tokens:generate": "node --experimental-strip-types scripts/write-tokens.mts"
  },
  "dependencies": {
    "next": "15.5.28",
    "next-auth": "5.0.0-beta.32",
    "openapi-fetch": "0.17.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.0.10",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.11",
    "openapi-typescript": "7.13.0",
    "postcss": "8.5.23",
    "tailwindcss": "4.3.3",
    "typescript": "5.7.3",
    "vitest": "4.1.12"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
