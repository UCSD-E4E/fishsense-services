# The v2 API. Inside the compose network: http://api:8000.
FISHSENSE_API_URL=http://api:8000
# The tenant every API call acts in (PLAN.md §9.10). One tenant, `lab`, at cutover.
FISHSENSE_TENANT=lab

# The web's Authentik service account, for the public landing page (it has no
# user to ask the API as). An app password, used with the web's own client id
# in Authentik's client_credentials flow. It needs a membership in the tenant
# (role `member` is enough), granted administratively like anyone's.
FISHSENSE_API_SERVICE_USERNAME=
FISHSENSE_API_SERVICE_PASSWORD=

# Kill-switch for the Label Studio integration. Off unless explicitly truthy —
# the literal `false`, an empty value, and an unset var all leave it off.
# Disabled, the landing page's four labeling sections collapse and triage is
# empty, and neither the API nor Label Studio is asked anything.
LABEL_STUDIO_ENABLED=false

# Both read only when LABEL_STUDIO_ENABLED is truthy. The key is a personal
# access (refresh) token, exchanged for a short-lived bearer.
LABEL_STUDIO_URL=https://app.heartex.com
LABEL_STUDIO_API_KEY=
# Where the landing page's project cards link. Defaults to LABEL_STUDIO_URL.
LABELER_BASE=

# Hosts triage may fetch a frame from, besides Label Studio's own. The object
# store's host is allowed from its endpoint; add others comma-separated.
FISHSENSE_OBJECT_STORE_ENDPOINT_URL=
TRIAGE_IMAGE_HOSTS=

# Static links (optional overrides).
# ANALYTICS_BASE=https://analytics.fishsense.e4e.ucsd.edu/superset/dashboard
# WORKFLOWS_URL=https://workflows.krg.ucsd.edu/namespaces/fishsense

# OAuth via Authentik (gates /portal/*; the landing page stays public).
# AUTH_SECRET: generate with `openssl rand -base64 32`. Encrypts the session.
AUTH_SECRET=
# The web's confidential OIDC client. Its id must be one of the API's
# FISHSENSE_OIDC_AUDIENCES, since the portal calls the API with the user's
# access token. The provider must grant `refresh_token` and map the
# `offline_access`, `groups` and `org` scopes.
AUTH_AUTHENTIK_ID=
AUTH_AUTHENTIK_SECRET=
# Issuer URL — include the application slug, no trailing slash, e.g.
# https://auth.e4e.ucsd.edu/application/o/fishsense-web
AUTH_AUTHENTIK_ISSUER=
# Required outside localhost (OAuth callbacks are otherwise built against the
# container's listen address, 0.0.0.0:3000).
AUTH_URL=
