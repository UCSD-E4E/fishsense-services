# apps/web on the host (`npm run dev`) against the UI harness (compose.ui.yml).
# The mock sign-in accepts any secret and password, so up.sh makes those up
# at launch (AUTH_SECRET, AUTH_AUTHENTIK_SECRET, FISHSENSE_API_SERVICE_PASSWORD)
# rather than this file holding any.
FISHSENSE_API_URL=http://localhost:8000
FISHSENSE_TENANT=lab
AUTH_URL=http://localhost:3000
AUTH_AUTHENTIK_ID=fishsense-web
AUTH_AUTHENTIK_ISSUER=http://localhost:9090/fishsense-web
FISHSENSE_API_SERVICE_USERNAME=web-service
LABEL_STUDIO_ENABLED=false
FISHSENSE_OBJECT_STORE_ENDPOINT_URL=http://localhost:3900
