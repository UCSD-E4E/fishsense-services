# direnv: loads the flake's dev shell (via nix-direnv) and the uv workspace venv.
# Run `direnv allow` once after cloning, and again whenever this file changes.
use flake

# The uv workspace venv, so `pytest` etc. resolve without `uv run`. Synced on
# every reload (a no-op when current), and direnv reloads when the lock or a
# pyproject changes -- so a pull that moves the lock resyncs the venv.
# `--frozen`, as in CI: install the committed lock, never rewrite it.
watch_file pyproject.toml uv.lock services/*/pyproject.toml
uv sync --all-packages --frozen
export VIRTUAL_ENV="$PWD/.venv"
PATH_add .venv/bin

# Local settings for compose (FISHSENSE_NAS_*, FISHSENSE_OIDC_ISSUER, ...; see
# compose.yml). Never committed.
dotenv_if_exists .env

# Per-person overrides, also never committed.
source_env_if_exists .envrc.local
